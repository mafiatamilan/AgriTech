SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
AGENT_WEBHOOK_SECRET=your-shared-webhook-secret
AGENT_DISPATCH_URL=http://localhost:8000/webhooks/agent-result
HARDWARE_COMMAND_SECRET=your-hardware-command-secret
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
LLM_API_KEY=your-llm-api-key
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=opencode
LLM_MODEL=

# Plant disease model provider: pddd, roboflow, or auto
PLANT_DISEASE_PROVIDER=pddd
PDDD_MODEL_PATH=models/mobilenet_v3_large-model-84.pth
PDDD_LABELS_PATH=models/class_indices.json

# Impact metric constants (demo factors)
PUMP_FLOW_LITERS_PER_MIN=40.0
DEFAULT_WATERING_MINUTES=30.0
CO2E_FACTOR_KG_PER_KG_FOOD=2.5
INDIAN_RUPEE_PER_USD=83.0
